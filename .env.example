# ---------------------------------------------------------------------------
# Razorpay
# ---------------------------------------------------------------------------
# Get keys from https://dashboard.razorpay.com/app/keys
#
# The SECRET is server-side only. It must NEVER be given a VITE_ prefix — Vite
# inlines every VITE_-prefixed variable into the browser bundle, which would
# publish your secret to anyone who opens devtools.
#
# Only the key_id is ever sent to the browser. That is by design; it is a public
# identifier, not a credential.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Kept for reference — not currently read by any code.
#
# The frontend does NOT read this. It gets the key id from the
# POST /api/create-order response instead, so the browser and the server can
# never disagree about which key is in use. Setting this to a different value
# will have no effect.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the Express API listens on. The Vite dev server (5174) proxies /api here.
PORT=5175
